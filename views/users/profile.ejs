<% layout("/layouts/boilerplate") %>

<style>
:root {
  --primary: #ff385c;
  --primary-hover: #e00b41;
  --primary-light: #fff0f3;
  --dark: #222222;
  --text-muted: #717171;
  --border-color: #ebebeb;
  --card-bg: #ffffff;
  --bg-subtle: #f7f7f9;
  --radius-lg: 20px;
  --radius-md: 14px;
  --radius-sm: 8px;
  --shadow-subtle: 0 4px 24px rgba(0, 0, 0, 0.06);
  --shadow-hover: 0 10px 30px rgba(0, 0, 0, 0.1);
  --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.wander-profile-wrapper {
  max-width: 900px;
  margin: 40px auto;
  padding: 0 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--dark);
}

/* Outer Card */
.wander-profile-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-subtle);
  overflow: hidden;
  transition: var(--transition);
}

/* Wanderlust Cover Banner */
.wander-banner {
  height: 180px;
  background: linear-gradient(135deg, #ff385c 0%, #e61e4d 40%, #d70466 100%);
  position: relative;
}

.banner-overlay {
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at top right, rgba(255,255,255,0.2) 0%, transparent 60%);
}

/* Card Body */
.wander-content {
  padding: 0 32px 36px;
  position: relative;
}

/* Top Bar: Avatar + Action Button */
.wander-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: -65px;
  margin-bottom: 20px;
}

.avatar-container {
  position: relative;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  border: 4px solid #ffffff;
  background: #ffffff;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}

.active-indicator {
  position: absolute;
  bottom: 8px;
  right: 8px;
  width: 16px;
  height: 16px;
  background-color: #008a05;
  border: 3px solid #ffffff;
  border-radius: 50%;
}

/* Edit Button */
.btn-edit-profile {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: #ffffff;
  color: var(--dark);
  border: 1px solid #b0b0b0;
  padding: 10px 20px;
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  transition: var(--transition);
}

.btn-edit-profile:hover {
  background-color: var(--bg-subtle);
  border-color: var(--dark);
  transform: translateY(-1px);
}

/* User Identity Section */
.user-meta {
  margin-bottom: 30px;
}

.name-badge-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.user-name {
  font-size: 1.85rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.5px;
}

.role-badge {
  background: var(--primary-light);
  color: var(--primary);
  font-size: 0.8rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.user-email {
  margin-top: 6px;
  color: var(--text-muted);
  font-size: 0.95rem;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

/* Grid Layout */
.wander-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

/* Individual Cards */
.detail-card {
  background: var(--bg-subtle);
  border: 1px solid rgba(0, 0, 0, 0.04);
  border-radius: var(--radius-md);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: var(--transition);
}

.detail-card:hover {
  background: #ffffff;
  border-color: var(--border-color);
  box-shadow: var(--shadow-hover);
  transform: translateY(-2px);
}

.card-icon-wrapper {
  width: 40px;
  height: 40px;
  background: #ffffff;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--dark);
  font-size: 1.1rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.card-icon-wrapper.heart-accent {
  color: var(--primary);
}

.card-text-block {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.card-label {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.card-value {
  font-size: 1rem;
  font-weight: 600;
  color: var(--dark);
  margin: 0;
  word-break: break-word;
}

/* Wishlist Badge */
.wishlist-badge {
  display: inline-flex;
  align-items: center;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--primary);
}

/* Full Width Bio Card */
.card-full-span {
  grid-column: 1 / -1;
  background: #ffffff;
  border: 1px dashed var(--border-color);
}

.bio-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.bio-description {
  margin: 0;
  color: #484848;
  font-size: 0.98rem;
  line-height: 1.65;
}

/* Responsive Mobile View */
@media (max-width: 768px) {
  .wander-grid {
    grid-template-columns: 1fr;
  }

  .wander-top-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .btn-edit-profile {
    width: 100%;
    justify-content: center;
  }

  .wander-content {
    padding: 0 20px 24px;
  }

  .user-name {
    font-size: 1.5rem;
  }
}

</style>

<div class="wander-profile-wrapper">
  <div class="wander-profile-card">
    
    <!-- Hero / Banner Section -->
    <div class="wander-banner">
      <div class="banner-overlay"></div>
    </div>

    <!-- Main Content Container -->
    <div class="wander-content">
      
      <!-- Top Action Bar (Avatar + Identity + Edit) -->
      <div class="wander-top-bar">
        <div class="avatar-container">
          <img 
            src="<%= user.profileImage?.url || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>" 
            alt="<%= user.username %>'s Profile" 
            class="avatar-img"
          >
          <span class="active-indicator" title="Active Wanderer"></span>
        </div>

        <div class="action-btn-group">
          <a href="/profile/edit" class="btn-edit-profile">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>Edit Profile</span>
          </a>
        </div>
      </div>

      <!-- User Identity -->
      <div class="user-meta">
        <div class="name-badge-wrap">
          <h1 class="user-name"><%= user.username %></h1>
          <span class="role-badge"><i class="fa-solid fa-compass"></i> Explorer</span>
        </div>
        <p class="user-email">
          <i class="fa-regular fa-envelope"></i>
          <span><%= user.email %></span>
        </p>
      </div>

      <!-- Quick Stats / Highlights Grid -->
      <div class="wander-grid">
        
        <!-- Phone Card -->
        <div class="detail-card">
          <div class="card-icon-wrapper">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div class="card-text-block">
            <span class="card-label">Contact Number</span>
            <p class="card-value"><%= user.phone || "Not provided" %></p>
          </div>
        </div>

        <!-- Joined Date Card -->
        <div class="detail-card">
          <div class="card-icon-wrapper">
            <i class="fa-regular fa-calendar-check"></i>
          </div>
          <div class="card-text-block">
            <span class="card-label">Member Since</span>
            <p class="card-value">
              <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : "N/A" %>
            </p>
          </div>
        </div>

        <!-- Wishlist Card -->
        <div class="detail-card">
          <div class="card-icon-wrapper heart-accent">
            <i class="fa-solid fa-heart"></i>
          </div>
          <div class="card-text-block">
            <span class="card-label">Saved Wishlist</span>
            <div class="wishlist-badge">
              <span><%= user.wishlist ? user.wishlist.length : 0 %> Places Saved</span>
            </div>
          </div>
        </div>

        <!-- Bio Card (Full Row) -->
        <div class="detail-card card-full-span">
          <div class="bio-header">
            <div class="card-icon-wrapper">
              <i class="fa-solid fa-quote-left"></i>
            </div>
            <span class="card-label">About Wanderer</span>
          </div>
          <p class="bio-description">
            <%= user.bio || "No bio added yet. Share a bit about your travel style, favorite destinations, or your next bucket list spot!" %>
          </p>
        </div>

      </div>
    </div>
  </div>
</div>
