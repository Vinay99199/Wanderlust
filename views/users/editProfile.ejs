<% layout("/layouts/boilerplate") %>

<div class="container col-md-6 mt-5">

    <h2>Edit Profile</h2>

    <form action="/profile/edit" method="POST">

        <div class="mb-3">
            <label>Email</label>
            <input
                type="email"
                name="email"
                class="form-control"
                value="<%= user.email %>"
            >
        </div>

        <div class="mb-3">
            <label>Phone</label>
            <input
                type="text"
                name="phone"
                class="form-control"
                value="<%= user.phone %>"
            >
        </div>

        <div class="mb-3">
            <label>Bio</label>

            <textarea
                name="bio"
                class="form-control"
                rows="4"><%= user.bio %></textarea>
        </div>

        <div class="mb-3">
            <label>Profile Image URL</label>

            <input
                type="text"
                name="profileImage"
                class="form-control"
                value="<%= user.profileImage?.url %>"
            >
        </div>

        <button class="btn btn-danger ">
            Save Changes
        </button>

    </form>

</div>

