<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Login</h1>
    <div class="col-6 offset-3">
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input 
                    type="text" name="username" 
                    id="username" class="form-control placeholder:text-gray-400 placeholder:opacity-5" placeholder="e.g. vinay123" required
                />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input 
                    type="password" name="password" 
                    id="password" type="password" 
                    class="form-control placeholder:text-gray-400 placeholder:opacity-5" placeholder="e.g. 12345678" required
                />
                <div class="valid-feedback">Looks good</div>
            </div>
            <button class="btn btn-success mb-2">Login</button>
        </form>
    </div>
</div>
