<% layout("/layouts/boilerplate") %>

<style>
    .favourite-page {
        padding: 20px 0 50px;
    }

    .favourite-title {
        margin-bottom: 30px;
        font-weight: 700;
        color: #222;
    }

    .listing-card {
        height: 100%;
        overflow: hidden;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .listing-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12);
    }

    .listing-image {
        display: block;
        width: 100%;
        height: 230px;
        object-fit: cover;
    }

    .listing-link {
        color: inherit;
        text-decoration: none;
    }

    .listing-link:hover {
        color: inherit;
    }

    .card-body {
        padding: 18px;
    }

    .listing-info {
        position: relative !important;
        display: block !important;
        width: 100% !important;
        min-height: 24px !important;
        margin-bottom: 15px !important;
        padding: 0 !important;
    }

    .listing-title {
        display: block !important;
        width: calc(100% - 130px) !important;
        margin: 0 !important;
        padding: 0 !important;
        font-size: 17px !important;
        font-weight: 600 !important;
        color: #222 !important;
        text-decoration: none !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        line-height: 24px !important;
    }

    .listing-price {
        position: absolute !important;
        top: 0 !important;
        right: 0 !important;
        display: block !important;
        width: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        font-size: 14px !important;
        color: #555 !important;
        white-space: nowrap !important;
        line-height: 24px !important;
        text-align: right !important;
    }

    .listing-price strong {
        color: #222 !important;
        font-size: 15px !important;
        white-space: nowrap !important;
    }

    .listing-price span {
        color: #777 !important;
        font-size: 13px !important;
        white-space: nowrap !important;
    }

    .remove-favourite {
        display: block;
        width: 100%;
        padding: 9px 15px;
        background: #fff;
        border: 1px solid #fe424d;
        border-radius: 25px;
        color: #fe424d;
        font-weight: 600;
        transition: 0.3s ease;
    }

    .remove-favourite:hover {
        background: #fe424d;
        color: #fff;
    }

    .empty-favourites {
        padding: 60px 20px;
        text-align: center;
        background: #fafafa;
        border-radius: 15px;
    }

    .empty-favourites i {
        margin-bottom: 15px;
        font-size: 45px;
        color: #fe424d;
    }

    .empty-favourites h4 {
        margin-bottom: 8px;
    }

    .empty-favourites p {
        margin-bottom: 20px;
        color: #777;
    }

    .explore-btn {
        padding: 10px 22px;
        background: #fe424d;
        border: none;
        border-radius: 25px;
        color: #fff;
        font-weight: 600;
    }

    .explore-btn:hover {
        background: #e03150;
        color: #fff;
    }

    @media (max-width: 576px) {
        .favourite-page {
            padding: 15px 10px 40px;
        }

        .favourite-title {
            font-size: 24px;
        }

        .listing-image {
            height: 210px;
        }

        .listing-title {
            width: calc(100% - 115px) !important;
            font-size: 16px !important;
        }

        .listing-price {
            font-size: 13px !important;
        }

        .listing-price strong {
            font-size: 14px !important;
        }

        .listing-price span {
            font-size: 12px !important;
        }
    }
</style>

<div class="container favourite-page">

    <h2 class="favourite-title">
        <i class="fa-solid fa-heart text-danger"></i>
        My Favourite Listings
    </h2>

    <% if (allListings.length === 0) { %>

        <div class="empty-favourites">
            <i class="fa-regular fa-heart"></i>
            <h4>No Favourite Listings Yet</h4>
            <p>Save your favourite places here and find them easily later.</p>
            <a href="/listings" class="btn explore-btn">
                Explore Listings
            </a>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% for (let listing of allListings) { %>

                <div class="col-lg-4 col-md-6">

                    <div class="card listing-card">

                        <a
                            href="/listings/<%= listing._id %>"
                            class="listing-link"
                        >
                            <img
                                src="<%= listing.image.url %>"
                                class="listing-image card-img-top"
                                alt="<%= listing.title %>"
                            >
                        </a>

                        <div class="card-body">

                            <div class="listing-info">

                                <a
                                    href="/listings/<%= listing._id %>"
                                    class="listing-title"
                                >
                                    <%= listing.title %>
                                </a>

                                <div class="listing-price">
                                    <strong>
                                        ₹<%= listing.price.toLocaleString("en-IN") %>
                                    </strong>
                                    <span>/ night</span>
                                </div>

                            </div>

                            <form
                                action="/listings/<%= listing._id %>/wishlist"
                                method="POST"
                                class="remove-favourite-form"
                            >
                                <button
                                    type="submit"
                                    class="btn remove-favourite"
                                >
                                    <i class="fa-solid fa-heart-crack me-1"></i>
                                    Remove Favourite
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

            <% } %>

        </div>

    <% } %>

</div>

<script>
document.querySelectorAll(".remove-favourite-form").forEach(form => {

    form.addEventListener("submit", async function(e) {
        e.preventDefault();

        try {
            const response = await fetch(this.action, {
                method: "POST",
                headers: {
                    "Accept": "application/json"
                }
            });

            const contentType = response.headers.get("content-type");

            if (!response.ok) {
                const text = await response.text();
                console.error("WISHLIST RESPONSE:", text);
                throw new Error("Remove favourite failed");
            }

            if (!contentType || !contentType.includes("application/json")) {
                const text = await response.text();
                console.error("EXPECTED JSON BUT GOT:", text);
                throw new Error("Server returned HTML instead of JSON");
            }

            const data = await response.json();

            if (data.success) {
                window.location.href = "/listings/favourites";
            }

        } catch (error) {
            console.error("Remove favourite error:", error);
            window.location.reload();
        }
    });

});
</script>