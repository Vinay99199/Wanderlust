<% layout("/layouts/boilerplate") %>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

    <div class="container mt-4">
        <div class="row">

            <!-- LEFT SIDE -->
            <div class="col-lg-8">
                <h2 class="mb-3 fw-bold">
                    <%= listing.title %>
                </h2>

                <div class="card listing-card border-0 shadow">
                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top show-img"
                        alt="listing image"
                    />

                    <!-- Card Content -->
                    <div class="card-body p-4">
                        <p class="mb-3">
                            <strong>Hosted by</strong>
                            <%= listing.owner.username %>
                        </p>

                        <p class="mb-4 leading-relaxed">
                            <%= listing.description %>
                        </p>

                        <h4 class="text-danger mb-3">
                            ₹<%= listing.price.toLocaleString("en-IN") %>
                            <small class="text-muted fs-6">/ night</small>
                        </h4>

                        <p class="mb-0">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </p>
                    </div>
                </div>

                <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
                    <div class="mt-3 d-flex gap-3">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
                            Edit
                        </a>

                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>

            <!-- RIGHT SIDE BOOKING CARD -->
            <div class="col-lg-4">
                <% if (currUser) { %>
                    <% if (!listing.owner._id.equals(currUser._1d)) { %>
                    <% } %>

                    <% if (!listing.owner._id.equals(currUser._id)) { %>
                        <div
                            class="card shadow"
                            style="
                                border-radius:18px;
                                position:sticky;
                                top:90px;
                            "
                        >
                            <div class="card-body p-2 ">
                                <h3 class="mb-3">
                                    ₹<%= listing.price.toLocaleString("en-IN") %>
                                    <small class="fs-6 text-muted">/ night</small>
                                </h3>

                                <form id="bookingForm">
                                    <div class="mb-3">
                                        <label class="form-label">Check In</label>
                                        <input type="date" class="form-control" name="checkIn" id="checkIn" required />
                                    </div>
                                
                                    <div class="mb-3">
                                        <label class="form-label">Check Out</label>
                                        <input type="date" class="form-control" name="checkOut" id="checkOut" required />
                                    </div>
                                
                                    <div class="mb-3">
                                        <label class="form-label">Guests</label>
                                        <input type="number" class="form-control" name="guests" id="guests" value="1" min="1" max="20" required />
                                    </div>
                                
                                    <!-- Coupon Code -->
                                    <div class="mb-3">
                                        <label class="form-label">Coupon Code</label>
                                
                                        <div class="input-group">
                                            <input type="text" class="form-control" id="couponCode" placeholder="Enter coupon code" />
                                
                                            <button type="button" class="btn btn-dark" id="applyCoupon">
                                                Apply
                                            </button>
                                        </div>
                                
                                        <small class="text-muted">
                                            Use <strong>WANDER10</strong> for 10% off
                                        </small>
                                
                                        <div id="couponMessage" class="mt-2"></div>
                                    </div>
                                
                                    <!-- Price Details -->
                                    <div id="priceDetails" class="mb-3" style="display:none;">
                                        <p class="mb-1">
                                            <strong>Original Price:</strong>
                                            ₹<span id="originalPrice">0</span>
                                        </p>
                                
                                        <p class="mb-1 text-success">
                                            <strong>Discount:</strong>
                                            - ₹<span id="discountAmount">0</span>
                                        </p>
                                
                                        <p class="mb-2">
                                            <strong>Total Price:</strong>
                                            ₹<span id="finalPrice">0</span>
                                        </p>
                                    </div>
                                
                                    <button type="button" id="payBtn" class="btn btn-danger w-100">
                                        Pay & Book
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="card shadow">
                        <div class="card-body text-center">
                            <h5>Login to Book</h5>
                            <a href="/login" class="btn btn-dark w-100 mt-3">Login</a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <hr class="my-5" />

        <!-- REVIEW SECTION -->
        <div class="row mt-4">
            <div class="col-lg-8">
                <% if (currUser) { %>
                    <hr />
                    <h3 class="mb-3">Leave a Review</h3>

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>/reviews"
                        novalidate
                        class="needs-validation"
                    >
                        <div class="mb-3">
                              <p class="form-label mb-2"> Rating  </p>

                            <fieldset class="starability-slot">
                                <input
                                    type="radio"
                                    id="no-rate"
                                    class="input-no-rate"
                                    name="review[rating]"
                                    value="1"
                                    checked
                                />

                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1">1 star</label>

                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2">2 stars</label>

                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3">3 stars</label>

                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4">4 stars</label>

                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5">5 stars</label>
                            </fieldset>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label">Comment</label>

                            <textarea
                                id="comment"
                                rows="5"
                                name="review[comment]"
                                class="form-control"
                                required
                            ></textarea>

                            <div class="invalid-feedback">Please enter your review.</div>
                        </div>

                        <button class="btn btn-outline-dark">Submit Review</button>
                    </form>
                <% } %>

                <hr />

                <% if (listing.reviews.length > 0) { %>
                    <h3 class="mb-3">Guest Reviews</h3>

                    <div class="row">
                        <% for (let review of listing.reviews) { %>
                            <div class="col-md-6 mb-4">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body ps-2">
                                        <h5 class="card-title"><%= review.author.username %></h5>

                                        <p class="starability-result" data-rating="<%= review.rating %>"></p>

                                        <p><%= review.comment %></p>

                                        <% if (currUser && review.author._id.equals(currUser._id)) { %>
                                            <form
                                                method="POST"
                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            >
                                                <button class="btn btn-sm btn-danger">Delete Review</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- MAP -->
        <div class="row mt-4 mb-1">
            <div class="col-lg-12">
                <h3 class="mb-3">Where You'll Be</h3>
                <div id="map"></div>
            </div>
        </div>
    </div>

    <script src="/js/map.js"></script>

<script>
const payBtn = document.getElementById("payBtn");
const applyCoupon = document.getElementById("applyCoupon");

if (applyCoupon) {
    applyCoupon.addEventListener("click", () => {
        const couponCode = document.getElementById("couponCode").value.trim().toUpperCase();
        const checkIn = document.getElementById("checkIn").value;
        const checkOut = document.getElementById("checkOut").value;

        if (!checkIn || !checkOut) {
            alert("Please select Check In and Check Out dates first.");
            return;
        }

        if (!couponCode) {
            alert("Please enter coupon code.");
            return;
        }

        if (couponCode !== "WANDER10") {
            document.getElementById("couponMessage").innerHTML =
                '<span class="text-danger">Invalid coupon code.</span>';
            return;
        }

        const nights = Math.ceil(
            (new Date(checkOut) - new Date(checkIn)) /
            (1000 * 60 * 60 * 24)
        );

        const originalPrice = nights * <%= listing.price %>;
        const discountAmount = Math.round(originalPrice * 10 / 100);
        const finalPrice = originalPrice - discountAmount;

        document.getElementById("originalPrice").innerText = originalPrice;
        document.getElementById("discountAmount").innerText = discountAmount;
        document.getElementById("finalPrice").innerText = finalPrice;

        document.getElementById("priceDetails").style.display = "block";

        document.getElementById("couponMessage").innerHTML =
            '<span class="text-success">Coupon applied successfully!</span>';
    });
}

if (payBtn) {
    payBtn.addEventListener("click", async () => {
        try {
            const checkIn = document.getElementById("checkIn").value;
            const checkOut = document.getElementById("checkOut").value;
            const guests = document.getElementById("guests").value;
            const couponCode = document.getElementById("couponCode").value.trim().toUpperCase();

            if (!checkIn || !checkOut) {
                alert("Please select Check In and Check Out dates.");
                return;
            }

            if (new Date(checkOut) <= new Date(checkIn)) {
                alert("Check Out must be after Check In.");
                return;
            }

            const response = await fetch(
                "/bookings/<%= listing._id %>/create-order",
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        checkIn,
                        checkOut,
                        guests,
                        couponCode
                    })
                }
            );

            const result = await response.json();

            console.log("PAY ORDER RESULT =>", result);

            if (!response.ok) {
                alert(result.message || "These dates are not available.");
                return;
            }

            const options = {
                key: "<%= process.env.RAZORPAY_KEY_ID %>",
                amount: result.amount,
                currency: result.currency,
                name: "Wanderlust",
                description: "Listing Booking",
                order_id: result.id,

                handler: async function (payment) {
                    try {
                        const verify = await fetch(
                            "/bookings/<%= listing._id %>/verify-payment",
                            {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({
                                    razorpay_order_id: payment.razorpay_order_id,
                                    razorpay_payment_id: payment.razorpay_payment_id,
                                    razorpay_signature: payment.razorpay_signature,
                                    checkIn,
                                    checkOut,
                                    guests,
                                    couponCode
                                })
                            }
                        );

                        const result = await verify.json();

                        if (result.success) {
                            alert("Payment Successful & Booking Confirmed");
                            window.location.href = "/bookings/my";
                        } else {
                            alert(result.message || "Booking could not be completed.");
                        }

                    } catch (err) {
                        console.error("VERIFY ERROR =>", err);
                        alert("Payment verification failed.");
                    }
                },

                modal: {
                    ondismiss: function () {
                        console.log("Razorpay Checkout closed by user.");
                    }
                },

                theme: {
                    color: "#fe424d"
                }
            };

            const rzp = new Razorpay(options);

            rzp.on("payment.failed", function (response) {
                console.log("PAYMENT FAILED =>", response.error);
                alert("Payment Failed. Please try again.");
            });

            rzp.open();

        } catch (err) {
            console.error("CREATE ORDER ERROR =>", err);
            alert("Order Creation Failed");
        }
    });
}
</script>