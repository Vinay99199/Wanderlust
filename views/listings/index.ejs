<% layout("/layouts/boilerplate")%>
  <style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        width: 100%;
    }

    .filter {
        text-align: center;
        margin-right: 0;
        margin-top: 2rem;
        opacity: 0.8;
        flex-shrink: 0;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
        margin-bottom: 0;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        text-align: center;
        border-radius: 1rem;
        height: 3.5rem;
        padding: 1rem;
        margin-left: 3rem;
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    #switchCheckDefault {
        cursor: pointer;
    }


       /* MOBILE / SMALL SCREEN */
    @media (max-width: 768px) {

        #filters {
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            gap: 1.3rem;
            padding: 0 1rem 10px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        /* Chrome / Edge / Safari */
        #filters::-webkit-scrollbar {
            display: none;
        }

        .filter {
            flex: 0 0 auto;
            margin-top: 1.3rem;
            min-width: 55px;
        }

        .filter p {
            white-space: nowrap;
            font-size: 0.75rem;
        }

        .tax-toggle {
            flex: 0 0 auto;
            margin-left: 1rem;
            margin-top: 1.3rem;
            white-space: nowrap;
        }

        /* Cards mobile par screen ke andar rahenge */
        .listing-card {
            width: 100%;
        }

        .listing-card img {
            width: 100%;
            height: 16rem;
            object-fit: cover;
        }
    }


    /* Extra Small Screen */

    @media (max-width: 480px) {

        #filters {
            gap: 1.1rem;
            padding-left: 0.7rem;
            padding-right: 0.7rem;
        }

        .filter {
            min-width: 50px;
        }

        .filter p {
            font-size: 0.7rem;
        }

        .tax-toggle {
            margin-left: 0.5rem;
            padding: 0.8rem;
            font-size: 0.85rem;
        }

    }


    /* Very Small Screen */

    @media (max-width: 360px) {

        #filters {
            gap: 0.9rem;
        }

        .filter {
            min-width: 45px;
        }

        .filter p {
            font-size: 0.65rem;
        }

        .tax-toggle {
            font-size: 0.75rem;
        }

    }

 /* LISTINGS GRID */
.listings-row {
    width: 100%;
}

.listing-card {
    width: 100%;
    border: none !important;
}

.listing-card img {
    width: 100%;
    height: 16rem;
    object-fit: cover;
}

.listings-row .col {
    min-width: 0;
}

.card-text {
    overflow-wrap: normal;
    word-break: normal;
}


/* Mobile */
@media (max-width: 767px) {

    .listings-row {
        width: 100%;
        margin-left: 0;
        margin-right: 0;
    }

    .listings-row .col {
        width: 100%;
        max-width: 100%;
    }

    .listing-card {
        width: 100%;
    }

    .listing-card img {
        width: 100%;
        height: 16rem;
        object-fit: cover;
    }

}


/* Tablet */
@media (min-width: 768px) and (max-width: 991px) {

    .listing-card img {
        height: 16rem;
    }

}


/* Desktop */
@media (min-width: 992px) {

    .listing-card img {
        height: 18rem;
    }

}


/* Large Desktop */
@media (min-width: 1200px) {

    .listing-card img {
        height: 20rem;
    }

}

  </style>
    <div id="filters">
        <div class="filter" data-filter="">
            <div><i class="fa-solid fa-house"></i></div>
            <p>All</p>
        </div>
        <div class="filter" data-filter="Trending">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
    
        <div class="filter" data-filter="Rooms">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
    
        <div class="filter" data-filter="Iconic Cities">
            <div><i class="fa-solid fa-city"></i></div>
            <p>Iconic Cities</p>
        </div>
    
        <div class="filter" data-filter="Mountains">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
    
        <div class="filter" data-filter="Castles">
            <div><i class="fa-solid fa-chess-rook"></i></div>
            <p>Castles</p>
        </div>
    
        <div class="filter" data-filter="Amazing Pools">
            <div><i class="fa-solid fa-water-ladder"></i></div>
            <p>Amazing Pools</p>
        </div>
    
        <div class="filter" data-filter="Camping">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
    
        <div class="filter" data-filter="Farms">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farms</p>
        </div>
    
        <div class="filter" data-filter="Arctic">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
    
        <div class="filter" data-filter="Domes">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </div>
    
        <div class="filter" data-filter="Boats">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </div>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch"> <input class="form-check-input" type="checkbox" role="switch"
                    id="switchCheckDefault"> <label class="form-check-label" for="switchCheckDefault">Display total after
                    taxes</label> </div>
        </div>
        </div>

    <div class="row listings-row g-3 mt-3">        
        <% for(let listing of allListings) { %> 
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 position-relative">

                <div class="heart-icon" data-id="<%= listing._id %>">
                    <i class="<%= wishlist.includes(listing._id.toString()) ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart"></i>
                </div>

                <a href="/listings/<%= listing._id %>" class="listing-link">

                <div class="card listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                  <div class="card-img-overlay"></div>
                  <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b><br>
                        ₹ <%= listing.price.toLocaleString("en-IN") %>/night<i class="tax-info">&nbsp; +17% GST</i>
                    </p>
                  </div>
                </div>
                </a>
            </div>
        <% } %> 
    </div>

<script>
        let taxSwitch = document.getElementById("switchCheckDefault");

        taxSwitch.addEventListener("click", () => {
            let taxInfoElements = document.querySelectorAll(".tax-info");

            taxInfoElements.forEach(elem => {
                if (elem.style.display === "inline") {
                    elem.style.display = "none";
                } else {
                    elem.style.display = "inline";
                }
            });
        });

    document.querySelectorAll(".heart-icon").forEach(icon => {
        icon.addEventListener("click", async function (e) {
            e.preventDefault();
            e.stopPropagation();
            const listingId = this.dataset.id;
            const response = await fetch(`/listings/${listingId}/wishlist`, {
                method: "POST"
            });
            const data = await response.json();
            if (data.success) {
                let heart = this.querySelector("i");
                heart.classList.toggle("fa-regular");
                heart.classList.toggle("fa-solid");
                heart.classList.toggle("text-danger");
            }
        });
    });

    document.querySelectorAll(".filter").forEach(filter => {
        filter.addEventListener("click", () => {
            const category = filter.dataset.filter;
            if (category === "") {
                window.location.href = "/listings";
            } else {
                window.location.href = `/listings?category=${encodeURIComponent(category)}`;
            }
        });
    });
</script>
