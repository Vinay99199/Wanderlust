<% layout("/layouts/boilerplate")%>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3>Edit your Listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label mb-0">Title</label>
            <input id="title" name="listing[title]" value="<%= listing.title %>" type="text" class="form-control "autocomplete="off"required>
            <div class="invalid-feedback">
                Title should be valid.
            </div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label mb-0">Description</label>
            <textarea id="description" name="listing[description]" class="form-control"autocomplete="off" required><%= listing.description %></textarea>
            <div class="invalid-feedback">
                Please enter a description.
            </div>
        </div>

        <div class="row mb-2 col-md-4 text-nowrap ">
            &nbsp;&nbsp;&nbsp; Original Listing Image<br>
            <img src="<%= originalImageUrl %>">
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Upload New Image</label>
            <input id="image"  name="listing[image]"  type="file" class="form-control"autocomplete="off">
        </div> 
        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label mb-0">Price</label>
            <input id="price" name="listing[price]" value="<%= listing.price %>" type="number" class="form-control"autocomplete="off"required>
            <div class="invalid-feedback">
                Price should be valid
            </div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label mb-0">Country</label>
            <input  id="country" name="listing[country]" value="<%= listing.country %>" type="text" class="form-control"autocomplete="off"required>
            <div class="invalid-feedback">
                Country name should be valid.
            </div>
        </div>
        </div>
        
        <div class="mb-3">
            <label for="location" class="form-label mb-0">Location</label>
            <input id="location" name="listing[location]" value="<%=listing.location %>" type="text" class="form-control"autocomplete="off"required>
            <div class="invalid-feedback">
                Location should be valid.
            </div>
        </div>

        <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
    </div>
</div>
