<% layout("/layouts/boilerplate") %>

<div class="container my-4">
    <div class="row">
        <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
            
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <h3 class="fw-bold mb-0">Edit Listing</h3>
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary btn-sm">Back</a>
                </div>

                <form method="POST"
                      action="/listings/<%= listing._id %>?_method=PUT"
                      class="needs-validation"
                      novalidate
                      enctype="multipart/form-data">

                    <!-- Title & Category in 1 Row -->
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="title" class="form-label fw-semibold">Title</label>
                            <input
                                id="title"
                                name="listing[title]"
                                type="text"
                                class="form-control"
                                value="<%= listing.title %>"
                                autocomplete="off"
                                required
                            >
                            <div class="invalid-feedback">Please enter a title.</div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="category" class="form-label fw-semibold">Category</label>
                            <select id="category" name="listing[category]" class="form-select" required>
                                <% const categories = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Boats"]; %>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat %>" <%= listing.category === cat ? "selected" : "" %>>
                                        <%= cat %>
                                    </option>
                                <% }) %>
                            </select>
                            <div class="invalid-feedback">Select a category.</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea
                            id="description"
                            name="listing[description]"
                            class="form-control"
                            rows="3"
                            autocomplete="off"
                            required
                        ><%= listing.description %></textarea>
                        <div class="invalid-feedback">Please enter a description.</div>
                    </div>

                    <!-- Image Section Side-by-Side (Current Image + Upload Input) -->
                    <div class="row align-items-center bg-light p-3 rounded-3 mx-0 mb-3 border">
                        <div class="col-sm-4 text-center mb-2 mb-sm-0">
                            <img
                                id="imagePreview"
                                src="<%= originalImageUrl %>"
                                alt="Listing Image"
                                class="img-fluid rounded border shadow-sm"
                                style="max-height: 120px; width: 100%; object-fit: cover;"
                            >
                        </div>
                        <div class="col-sm-8">
                            <label for="image" class="form-label fw-semibold mb-1">Replace Image</label>
                            <input
                                id="image"
                                name="listing[image]"
                                type="file"
                                class="form-control"
                                accept="image/*"
                                onchange="previewImage(event)"
                            >
                            <small class="text-muted">Leave empty if you don't want to change the image.</small>
                        </div>
                    </div>

                    <!-- Price, Location, Country in 1 Compact Row -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="price" class="form-label fw-semibold">Price / Night</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input
                                    id="price"
                                    name="listing[price]"
                                    type="number"
                                    min="0"
                                    class="form-control"
                                    value="<%= listing.price %>"
                                    autocomplete="off"
                                    required
                                >
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="location" class="form-label fw-semibold">Location</label>
                            <input
                                id="location"
                                name="listing[location]"
                                type="text"
                                class="form-control"
                                value="<%= listing.location %>"
                                autocomplete="off"
                                required
                            >
                        </div>

                        <div class="col-md-4 mb-3">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <input
                                id="country"
                                name="listing[country]"
                                type="text"
                                class="form-control"
                                value="<%= listing.country %>"
                                autocomplete="off"
                                required
                            >
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="mt-2 text-end">
                        <button class="btn btn-dark px-4 py-2">
                            Save Changes
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        const input = event.target;
        const previewImage = document.getElementById('imagePreview');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImage.src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>