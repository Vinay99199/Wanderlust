<style>
/* navbar */
.navbar {
    height: 5rem;   
    background-color: #fff !important;
    padding: 0 1rem;
}

.navbar-brand i {
    font-size: 2rem;
    color: #fe424d;
}

.nav-link {
    font-size: 1rem;
    color: #222 !important;
    margin-right: 0.7rem;
    transition: transform 0.3s, color 0.3s;
}

.nav-link:hover {
  background: #dfdfdf82;
  border-radius: 25px;
    color: #000000 !important;
}

.navbar-nav {
    align-items: center;
}

.search-inp {
    border-radius: 25px;
    padding: 0.5rem 1.2rem;
    font-size: 1rem;
    border: 1px solid #ddd;
    width: 250px;
}

/* .search-inp:hover {
    border: 1px solid #c8333340;
}
.search-inp:focus {
    outline: none;
    border: 1px solid #5ee6f3;
    box-shadow: 1px 1px 5px rgb(69, 215, 241);
} */

.search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0.5rem 1rem;
    margin-left: 0.5rem;
    display: flex;
    align-items: center;
    border: none;
}
.search-btn:hover {
  color: #ededed;
    background-color: #e03150;
}

.search-btn i {
    margin-right: 0.4rem;
}
.navbar {
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
      data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" 
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a href="/listings" class="nav-link">Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations…">
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search</button>
        </form>
      </div>

      <div class="navbar-nav ms-auto">
        <a href="/listings/new" class="nav-link">Airbnb your home</a>
        <% if(!currUser){ %>
        <a href="/signup" class="nav-link"><b>Sign up</b></a>
        <a href="/login" class="nav-link"><b>Log in</b></a>
        <% }%><% if(currUser) {%>
        <a href="/logout" class="nav-link"><b>Log out</b></a>
        <% } %>

      </div>
    </div>
  </div>
</nav>