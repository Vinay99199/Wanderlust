<style>
.navbar{
    min-height:5rem;
    background:#fff !important;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
    padding:.6rem 1rem;
    z-index:1050;
}
.nav-link{
    color:#222 !important;
    margin-right:.5rem;
    padding:.55rem .9rem;
    border-radius:25px;
    transition:.3s ease;
    font-weight:500;
}
.nav-link:hover{
    background:#f3f3f3;
}

.navbar-brand{
    display:flex;
    align-items:center;
    gap:10px;
    text-decoration:none;
}

.logo{
    width:auto;
    height:55px;
    object-fit:contain;
    display:block;
    flex-shrink:0;
}

.search-form{
    width:100%;
    max-width:430px;
}
.search-inp{
    border-radius:25px;
    width:260px;
    padding:.55rem 1rem;
}
.search-btn{
    border-radius:25px;
    background:#fe424d;
    color:#fff;
    border:none;
    padding:.55rem 1rem;
    transition:.3s;
    white-space:nowrap;
}
.search-btn:hover{
    background:#e03150;
    color:#fff;
}
.search-btn i{
    margin-right:5px;
}

.navbar-toggler{
    border:none;
    box-shadow:none !important;
}
.navbar-toggler:focus{
    box-shadow:none;
}

/* Blur Overlay */
.blur-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.15);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    opacity:0;
    visibility:hidden;
    transition:.3s ease;
    z-index:1040;
}
.blur-overlay.show{
    opacity:1;
    visibility:visible;
}
.navbar-collapse{
    position:relative;
    z-index:1060;
}

/* Tablet View */
@media(max-width:992px){
    .search-form{
        max-width:300px;
    }
    .search-inp{
        width:180px;
    }
}

/* Mobile View */
@media(max-width:768px){
    .navbar{
        padding:.8rem 1rem;
    }
    .navbar-collapse{
        margin-top:15px;
        background:#fff;
        padding:15px;
        border-radius:12px;
        box-shadow:0 4px 12px rgba(0,0,0,.08);
    }
    .navbar-nav{
        text-align:center;
    }
    .nav-item{
        width:100%;
    }
    .nav-link{
        display:block;
        margin:6px 0;
        padding:12px;
    }
    .logo{
        height:46px;
    }
    .search-form{
        display:flex;
        flex-direction:column;
        width:100%;
        margin:15px 0;
    }

    .search-inp{
        width:100%;
        margin:0 0 12px 0 !important;
    }

    .search-btn{
        width:100%;
    }
}

/* Small Mobile View */
@media(max-width:480px){

    .navbar{
        padding:.7rem .8rem;
    }

    .nav-link{
        font-size:15px;
        padding:10px;
    }
    .logo{
        height:40px;
    }
    .search-inp{
        font-size:14px;
        padding:10px 15px;
    }

    .search-btn{
        font-size:14px;
        padding:10px;
    }
}

@media(max-width:360px){
    .nav-link{
        font-size:14px;
    }

    .search-inp{
        font-size:13px;
    }

    .search-btn{
        font-size:13px;
    }
}

</style> 


<nav class="navbar navbar-expand-md sticky-top">
    <div class="container-fluid">

        <!-- Toggle Button -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse" id="navbarNav">

            <!-- Brand -->
        <div class="me-auto">
            <a class="navbar-brand d-flex align-items-center brand-logo" href="/listings">
                <img
                    src="https://res.cloudinary.com/dqbzv0bgw/image/upload/w_128,h_128,c_fill/v1785667630/ChatGPT_Image_Aug_2_2026_03_52_00_PM_mndiaj.png"
                    alt="Wanderlust Logo"
                    class="logo">
       <!-- <span class="brand-name">WanderLust</span> -->
    </a>
</div>

            <!-- Search -->
            <form
                class="d-flex search-form mx-auto"
                action="/listings"
                method="GET">

                <input
                    class="form-control search-inp me-md-2"
                    type="search"
                    name="q"
                    placeholder="Search destinations..."
                >

                <button class="btn search-btn" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search
                </button>

            </form>

            <!-- Right Menu -->
            <ul class="navbar-nav ms-md-auto">

                <li class="nav-item">
                    <a href="/listings/new" class="nav-link">
                        Become a Host
                    </a>
                </li>

                <% if(!currUser){ %>
                    <li class="nav-item">
                        <a href="/signup" class="nav-link">
                            <strong>Sign Up</strong>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/login" class="nav-link">
                            <strong>Log In</strong>
                        </a>
                    </li>
                <% } %>

                <% if(currUser){ %>
                    <li class="nav-item">
                        <a href="/listings/favourites" class="nav-link">
                            <i class="fa-solid fa-heart text-danger"></i>
                            Favourite
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/profile" class="nav-link">
                            <i class="fa-solid fa-user text-dark"></i>
                            Profile
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/bookings/my" class="nav-link">
                            <i class="fa-solid fa-calendar-check text-primary"></i>
                            My Bookings
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/bookings/owner" class="nav-link">
                            <i class="fa-solid fa-users text-success"></i>
                            Received Bookings
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/logout" class="nav-link">
                            <strong>Log Out</strong>
                        </a>
                    </li>
                <% } %>
            </ul>
        </div>

    </div>
</nav>

<div class="blur-overlay" id="blurOverlay"></div>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const navbar = document.getElementById("navbarNav");
    const overlay = document.getElementById("blurOverlay");

    navbar.addEventListener("show.bs.collapse", () => {
        overlay.classList.add("show");
    });

    navbar.addEventListener("hide.bs.collapse", () => {
        overlay.classList.remove("show");
    });

    overlay.addEventListener("click", () => {
        bootstrap.Collapse.getOrCreateInstance(navbar).hide();
    });

});
</script>
