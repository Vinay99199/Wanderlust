
<style>
/* ==========================
   NAVBAR
========================== */

.navbar{
    min-height:5rem;
    background:#fff !important;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
    padding:.6rem 1rem;
}

.navbar-brand i{
    font-size:2rem;
    color:#fe424d;
}

.nav-link{
    color:#222 !important;
    margin-right:.5rem;
    padding:.55rem .9rem;
    border-radius:25px;
    transition:.3s ease;
    font-weight:500;
}

.nav-link:hover{
    background:#f3f3f3;
}

.search-form{
    width:100%;
    max-width:430px;
}

.search-inp{
    border-radius:25px;
    width:260px;
    padding:.55rem 1rem;
}

.search-btn{
    border-radius:25px;
    background:#fe424d;
    color:#fff;
    border:none;
    padding:.55rem 1rem;
    transition:.3s;
    white-space:nowrap;
}

.search-btn:hover{
    background:#e03150;
    color:#fff;
}

.search-btn i{
    margin-right:5px;
}

.navbar-toggler{
    border:none;
    box-shadow:none !important;
}

.navbar-toggler:focus{
    box-shadow:none;
}

/* ==========================
   TABLET
========================== */

@media(max-width:992px){

    .search-form{
        max-width:300px;
    }

    .search-inp{
        width:180px;
    }

}

/* ==========================
   MOBILE
========================== */

@media(max-width:768px){

    .navbar{
        padding:.8rem 1rem;
    }

    .navbar-collapse{
        margin-top:15px;
        background:#fff;
        padding:15px;
        border-radius:12px;
        box-shadow:0 4px 12px rgba(0,0,0,.08);
    }

    .navbar-nav{
        text-align:center;
    }

    .nav-item{
        width:100%;
    }

    .nav-link{
        display:block;
        margin:6px 0;
        padding:12px;
    }

    .search-form{
        display:flex;
        flex-direction:column;
        width:100%;
        margin:15px 0;
    }

    .search-inp{
        width:100%;
        margin:0 0 12px 0 !important;
    }

    .search-btn{
        width:100%;
    }

}

/* ==========================
   SMALL MOBILE
========================== */

@media(max-width:480px){

    .navbar{
        padding:.7rem .8rem;
    }

    .navbar-brand i{
        font-size:1.7rem;
    }

    .nav-link{
        font-size:15px;
        padding:10px;
    }

    .search-inp{
        font-size:14px;
        padding:10px 15px;
    }

    .search-btn{
        font-size:14px;
        padding:10px;
    }

}


@media(max-width:360px){

    .navbar-brand i{
        font-size:1.5rem;
    }

    .nav-link{
        font-size:14px;
    }

    .search-inp{
        font-size:13px;
    }

    .search-btn{
        font-size:13px;
    }

}
</style>


<nav class="navbar navbar-expand-md sticky-top">
    <div class="container-fluid">

        <!-- Logo -->
        <a class="navbar-brand" href="/listings">
            <i class="fa-regular fa-compass"></i>
        </a>

        <!-- Toggle Button -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse" id="navbarNav">

            <!-- Left -->
            <ul class="navbar-nav me-auto">

                <li class="nav-item">
                    <a class="nav-link" href="/listings">
                        Explore
                    </a>
                </li>

            </ul>

            <!-- Search -->
            <form
                class="d-flex search-form mx-auto"
                action="/listings"
                method="GET">

                <input
                    class="form-control search-inp me-md-2"
                    type="search"
                    name="q"
                    placeholder="Search destinations..."
                >

                <button class="btn search-btn" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search
                </button>
            </form>

            <!-- Right -->
            <ul class="navbar-nav ms-md-auto">

                <li class="nav-item">
                    <a href="/listings/new" class="nav-link">
                        Airbnb your home
                    </a>
                </li>

                <% if(!currUser){ %>
                <li class="nav-item">
                    <a href="/signup" class="nav-link">
                        <strong>Sign Up</strong>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/login" class="nav-link">
                        <strong>Log In</strong>
                    </a>
                </li>
                <% } %>

                <% if(currUser){ %>
                
                    <li class="nav-item">
                        <a href="/listings/favourites" class="nav-link">
                            <i class="fa-solid fa-heart text-danger"></i>
                            Favourite
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/profile" class="nav-link">
                            <i class="fa-solid fa-user text-dark"></i>
                            Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/bookings/my" class="nav-link">
                            <i class="fa-solid fa-calendar-check text-primary"></i>
                            My Bookings
                        </a>
                    </li>
                
                    <li class="nav-item">
                        <a href="/bookings/owner" class="nav-link">
                            <i class="fa-solid fa-users text-success"></i>
                            Received Bookings
                        </a>
                    </li>
                
                    <li class="nav-item">
                        <a href="/logout" class="nav-link">
                            <strong>Log Out</strong>
                        </a>
                    </li>
                
                    <% } %>
            </ul>
        </div>
    </div>
</nav>
