<% layout("/layouts/boilerplate") %>

<div class="my-bookings-page">

    <div class="my-bookings-header">
        <div>
            <h2>
                <i class="fa-solid fa-calendar-check"></i>
                My Bookings
            </h2>
            <p>View and manage your booked stays</p>
        </div>

        <span class="booking-count">
            <i class="fa-regular fa-calendar"></i>
            <%= bookings.length %> Booking<%= bookings.length !== 1 ? "s" : "" %>
        </span>
    </div>

    <% if(bookings.length === 0){ %>

        <div class="empty-bookings">
            <i class="fa-regular fa-calendar-xmark"></i>
            <h4>No bookings yet</h4>
            <p>You have not booked any listing yet.</p>
        </div>

    <% } else { %>

        <div class="my-booking-grid">

            <% bookings.forEach(booking => { %>

                <div class="my-booking-card">

                    <% if(booking.listing && booking.listing.image){ %>

                        <img
                            src="<%= booking.listing.image.url %>"
                            alt="Listing"
                            class="booking-image"
                        >

                    <% } else { %>

                        <div class="booking-image no-image">
                            <i class="fa-solid fa-house"></i>
                        </div>

                    <% } %>

                    <div class="booking-card-body">

                        <div class="booking-title-row">

                            <div>
                                <% if(booking.listing){ %>

                                    <h3>
                                        <%= booking.listing.title %>
                                    </h3>

                                    <p class="location">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <%= booking.listing.location %>,
                                        <%= booking.listing.country %>
                                    </p>

                                <% } else { %>

                                    <h3 class="text-danger">
                                        Listing Deleted
                                    </h3>

                                <% } %>
                            </div>

                            <% if(booking.bookingStatus === "Confirmed"){ %>

                                <span class="status confirmed">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Confirmed
                                </span>

                            <% } else if(booking.bookingStatus === "Completed"){ %>

                                <span class="status completed">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Completed
                                </span>

                            <% } else if(booking.bookingStatus === "Cancelled"){ %>

                                <span class="status cancelled">
                                    <i class="fa-solid fa-circle-xmark"></i>
                                    Cancelled
                                </span>

                            <% } else { %>

                                <span class="status pending">
                                    <i class="fa-solid fa-clock"></i>
                                    Pending
                                </span>

                            <% } %>

                        </div>


                        <div class="booking-price">

                            <strong>₹<%= booking.totalPrice %></strong>

                            <% if(booking.discountAmount && booking.discountAmount > 0){ %>

                                <span>
                                    <i class="fa-solid fa-tag"></i>
                                    ₹<%= booking.discountAmount %> off
                                </span>

                                <small>
                                    Original ₹<%= booking.originalPrice %>
                                </small>

                            <% } %>

                        </div>


                        <div class="booking-details">

                            <div class="detail">
                                <i class="fa-regular fa-calendar"></i>
                                <div>
                                    <strong>
                                        <%= new Date(booking.checkIn).toLocaleDateString("en-IN") %>
                                        →
                                        <%= new Date(booking.checkOut).toLocaleDateString("en-IN") %>
                                    </strong>
                                    <small>
                                        <%= booking.nights %> night<%= booking.nights !== 1 ? "s" : "" %>
                                    </small>
                                </div>
                            </div>

                            <div class="detail">
                                <i class="fa-solid fa-users"></i>
                                <div>
                                    <strong>
                                        <%= booking.guests %> Guest<%= booking.guests !== 1 ? "s" : "" %>
                                    </strong>
                                    <small>Number of guests</small>
                                </div>
                            </div>

                            <div class="detail">
                                <i class="fa-regular fa-calendar-plus"></i>
                                <div>
                                    <strong>
                                        <%= new Date(booking.createdAt).toLocaleDateString("en-IN") %>
                                    </strong>
                                    <small>Booked on</small>
                                </div>
                            </div>

                        </div>


                        <div class="booking-bottom">

                            <div>

                                <% if(booking.paymentStatus === "Paid"){ %>

                                    <span class="payment paid">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Paid
                                    </span>

                                <% } else if(booking.paymentStatus === "Refunded"){ %>

                                    <span class="payment refunded">
                                        <i class="fa-solid fa-rotate-left"></i>
                                        Refunded
                                    </span>

                                <% } else { %>

                                    <span class="payment pending-payment">
                                        <i class="fa-solid fa-clock"></i>
                                        Pending
                                    </span>

                                <% } %>

                            </div>


                            <% if(booking.listing){ %>

                                <a
                                    href="/listings/<%= booking.listing._id %>"
                                    class="view-btn"
                                >
                                    <i class="fa-regular fa-eye"></i>
                                    View Listing
                                </a>

                            <% } %>

                        </div>


                        <% if(booking.bookingStatus === "Cancelled" && booking.paymentStatus === "Refunded"){ %>

                            <div class="refund-box">
                                <div>
                                    <i class="fa-solid fa-circle-check"></i>
                                    <strong>Payment Refunded Successfully</strong>
                                </div>

                                <p>
                                    Your booking was cancelled by the host and your payment has been refunded successfully.
                                </p>

                                <% if(booking.refundedAt){ %>

                                    <small>
                                        Refund processed on
                                        <%= new Date(booking.refundedAt).toLocaleDateString("en-IN") %>
                                    </small>

                                <% } %>
                            </div>

                        <% } %>


                        <% if(booking.bookingStatus !== "Cancelled" && booking.bookingStatus !== "Completed"){ %>

                            <div class="cancel-area">

                                <form
                                    method="POST"
                                    action="/bookings/<%= booking._id %>?_method=DELETE"
                                >

                                    <button type="submit" class="cancel-booking-btn">
                                        <i class="fa-solid fa-xmark"></i>
                                        Cancel Booking
                                    </button>

                                </form>

                            </div>

                        <% } %>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>


<style>

.my-bookings-page {
    max-width: 1500px;
    margin: 0 auto;
    padding: 35px;
    min-height: calc(100vh - 80px);
    background: #f8fafc;
}

.my-bookings-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

.my-bookings-header h2 {
    margin: 0;
    color: #18283f;
    font-size: 34px;
    font-weight: 700;
}

.my-bookings-header h2 i {
    color: #159447;
    margin-right: 10px;
}

.my-bookings-header p {
    margin: 5px 0 0;
    color: #718096;
    font-size: 16px;
}

.booking-count {
    padding: 10px 18px;
    border-radius: 30px;
    background: #20262d;
    color: white;
    font-size: 14px;
    font-weight: 600;
}

.my-booking-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
}

.my-booking-card {
    overflow: hidden;
    background: white;
    border: 1px solid #e5eaf0;
    border-radius: 16px;
    box-shadow: 0 3px 12px rgba(20, 30, 50, 0.05);
}

.booking-image {
    width: 100%;
    height: 245px;
    display: block;
    object-fit: cover;
}

.no-image {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f1f3f5;
    color: #9aa4af;
    font-size: 50px;
}

.booking-card-body {
    padding: 20px;
}

.booking-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
}

.booking-title-row h3 {
    margin: 0 0 7px;
    color: #17283f;
    font-size: 21px;
    font-weight: 700;
}

.location {
    margin: 0;
    color: #718096;
    font-size: 14px;
}

.location i {
    margin-right: 4px;
}

.status,
.payment {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 13px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
}

.confirmed,
.completed {
    background: #dcf5e8;
    color: #16844a;
}

.pending {
    background: #fff0cf;
    color: #a96900;
}

.cancelled {
    background: #ffe1e5;
    color: #d92d43;
}

.booking-price {
    margin: 18px 0;
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
}

.booking-price strong {
    color: #17283f;
    font-size: 25px;
}

.booking-price span {
    color: #159447;
    font-size: 14px;
    font-weight: 600;
}

.booking-price small {
    color: #8993a0;
    text-decoration: line-through;
}

.booking-details {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 10px;
    padding: 18px 0;
    border-top: 1px solid #e8edf2;
    border-bottom: 1px solid #e8edf2;
}

.detail {
    display: flex;
    gap: 9px;
    min-width: 0;
}

.detail > i {
    color: #617188;
    margin-top: 3px;
}

.detail strong,
.detail small {
    display: block;
}

.detail strong {
    color: #334155;
    font-size: 13px;
    line-height: 1.5;
}

.detail small {
    margin-top: 3px;
    color: #8993a0;
    font-size: 12px;
}

.booking-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
}

.paid {
    background: #d9f1e6;
    color: #16844a;
}

.refunded {
    background: #ffe2e6;
    color: #d92d43;
}

.pending-payment {
    background: #fff0cf;
    color: #a96900;
}

.view-btn {
    padding: 9px 15px;
    border: 1px solid #1976ff;
    border-radius: 8px;
    background: white;
    color: #1976ff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
}

.view-btn:hover {
    background: #1976ff;
    color: white;
}

.refund-box {
    margin-top: 16px;
    padding: 14px;
    border-radius: 10px;
    background: #ecf9f2;
    border: 1px solid #c9ead8;
    color: #16844a;
}

.refund-box div {
    display: flex;
    align-items: center;
    gap: 7px;
}

.refund-box p {
    margin: 6px 0;
    color: #47735b;
    font-size: 13px;
}

.refund-box small {
    color: #638170;
}

.cancel-area {
    margin-top: 15px;
}

.cancel-booking-btn {
    width: 100%;
    padding: 9px 15px;
    border: 1px solid #dc3545;
    border-radius: 8px;
    background: white;
    color: #dc3545;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

.cancel-booking-btn:hover {
    background: #dc3545;
    color: white;
}

.empty-bookings {
    padding: 80px 20px;
    background: white;
    border: 1px solid #e5eaf0;
    border-radius: 16px;
    text-align: center;
}

.empty-bookings i {
    margin-bottom: 15px;
    color: #adb5bd;
    font-size: 55px;
}

.empty-bookings h4 {
    color: #25344d;
    font-weight: 700;
}

.empty-bookings p {
    color: #7b8794;
}

@media (max-width: 1100px) {

    .my-booking-grid {
        grid-template-columns: 1fr;
    }

    .my-booking-card {
        max-width: 850px;
        width: 100%;
        margin: auto;
    }

}

@media (max-width: 700px) {

    .my-bookings-page {
        padding: 25px 14px 45px;
    }

    .my-bookings-header {
        align-items: flex-start;
        gap: 15px;
    }

    .my-bookings-header h2 {
        font-size: 26px;
    }

    .my-bookings-header p {
        font-size: 14px;
    }

    .booking-count {
        padding: 8px 12px;
        font-size: 12px;
    }

    .booking-image {
        height: 210px;
    }

    .booking-title-row {
        flex-direction: column;
    }

    .booking-title-row h3 {
        font-size: 19px;
    }

    .booking-details {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .booking-bottom {
        align-items: stretch;
        flex-direction: column;
    }

    .view-btn {
        display: block;
        text-align: center;
    }

}

@media (max-width: 430px) {

    .my-bookings-header {
        flex-direction: column;
    }

    .my-booking-card {
        border-radius: 13px;
    }

    .booking-card-body {
        padding: 15px;
    }

    .booking-image {
        height: 190px;
    }

}

</style>