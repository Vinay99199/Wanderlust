<% layout("layouts/boilerplate") %>

<div class="support-page">
    <div class="support-card">

        <div class="support-header">
            <div class="support-icon">
                <i class="fa-solid fa-file-contract"></i>
            </div>
            <span class="support-badge"><i class="fa-solid fa-shield-halved"></i> Legal Agreement</span>
            <h1>Terms & Conditions</h1>
            <p>
                Please review these terms carefully. They govern your access to and use of the Wanderlust platform.
            </p>
            <div class="support-meta">
                <span><i class="fa-regular fa-clock"></i> Last updated: October 2024</span>
                <span><i class="fa-regular fa-circle-check"></i> Binding Agreement</span>
            </div>
        </div>

        <div class="policy-grid">
            
            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div class="policy-content">
                    <h2>1. Use of the Platform</h2>
                    <p>
                        Users must provide accurate, complete, and verified information while creating accounts, publishing listings, or completing bookings on Wanderlust.
                    </p>
                </div>
            </div>

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-house-user"></i>
                </div>
                <div class="policy-content">
                    <h2>2. Host Responsibilities</h2>
                    <p>
                        Hosts are solely responsible for providing accurate property details, real-time pricing, availability, rules, and reliable facility information.
                    </p>
                </div>
            </div>

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="policy-content">
                    <h2>3. Guest Bookings</h2>
                    <p>
                        Guests are required to review all property information, house rules, and cancellation policies prior to confirming a booking.
                    </p>
                </div>
            </div>

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div class="policy-content">
                    <h2>4. Account Security</h2>
                    <p>
                        Users are responsible for safeguarding their login credentials and for all activities performed under their registered accounts.
                    </p>
                </div>
            </div>

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div class="policy-content">
                    <h2>5. Policy Changes</h2>
                    <p>
                        Wanderlust reserves the right to modify these terms as needed. Continued use of the platform constitutes acceptance of updated terms.
                    </p>
                </div>
            </div>

        </div>

        <div class="support-contact-box">
            <div class="contact-box-icon">
                <i class="fa-solid fa-headset"></i>
            </div>
            <div class="contact-box-text">
                <h3>Have questions regarding our terms?</h3>
                <p>Our support and legal team is here to help you understand your rights and duties.</p>
            </div>
            <a href="/contact" class="support-btn">Contact Legal Team</a>
        </div>

    </div>
</div>