<% layout("layouts/boilerplate") %>

<div class="support-page">

    <div class="support-card">

        <div class="support-header">

            <div class="support-icon">
                <i class="fa-solid fa-file-contract"></i>
            </div>

            <h1>Terms & Conditions</h1>

            <p>
                Please read these terms carefully before using
                the Wanderlust platform.
            </p>

        </div>


        <div class="policy-section">
            <h2>Use of the Platform</h2>

            <p>
                Users must provide accurate information while creating
                accounts, listings, and bookings.
            </p>
        </div>


        <div class="policy-section">
            <h2>Listings</h2>

            <p>
                Hosts are responsible for providing accurate information
                about their properties, prices, availability, and facilities.
            </p>
        </div>


        <div class="policy-section">
            <h2>Bookings</h2>

            <p>
                Guests are responsible for reviewing listing information
                before making a booking.
            </p>
        </div>


        <div class="policy-section">
            <h2>User Accounts</h2>

            <p>
                Users are responsible for maintaining the security
                of their account credentials.
            </p>
        </div>


        <div class="policy-section">
            <h2>Changes to These Terms</h2>

            <p>
                Wanderlust may update these terms when necessary.
            </p>
        </div>

    </div>

</div>