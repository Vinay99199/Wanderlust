<% layout("layouts/boilerplate") %>

<div class="support-page">
    <div class="support-card">

        <div class="support-header">
            <div class="support-icon">
                <i class="fa-solid fa-paper-plane"></i>
            </div>
            <span class="support-badge"><i class="fa-solid fa-headset"></i> We're Here to Help</span>
            <h1>Get in Touch</h1>
            <p>
                Have questions, feedback, or need assistance with a booking? Fill out the form below or reach out to us directly.
            </p>
        </div>

        <div class="contact-grid">

            <div class="contact-info-panel">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="fa-solid fa-envelope-open-text"></i>
                    </div>
                    <div class="info-details">
                        <h3>Email Support</h3>
                        <p>Our team is online 24/7 to answer your queries.</p>
                        <a href="mailto:support@wanderlust.com">support@wanderlust.com</a>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="info-details">
                        <h3>Response Time</h3>
                        <p>We typically respond within 2 to 4 hours during business days.</p>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-icon">
                        <i class="fa-solid fa-shield-cat"></i>
                    </div>
                    <div class="info-details">
                        <h3>Safe & Secure</h3>
                        <p>Your messages are directly assigned to a dedicated support officer.</p>
                    </div>
                </div>
            </div>

            <div class="contact-form-panel">
                <form action="/contact" method="POST" class="contact-form">

                    <div class="form-group">
                        <label for="name">Your Name</label>
                        <div class="input-wrapper">
                            <i class="fa-regular fa-user input-icon"></i>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                value="<%= user ? user.username : '' %>"
                                placeholder="John Doe"
                                <% if (user) { %>readonly class="readonly-input"<% } else { %>required<% } %>>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <div class="input-wrapper">
                            <i class="fa-regular fa-envelope input-icon"></i>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="<%= user ? user.email : '' %>"
                                placeholder="you@example.com"
                                <% if (user) { %>readonly class="readonly-input"<% } else { %>required<% } %>>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="subject">Subject</label>
                        <div class="input-wrapper">
                            <i class="fa-regular fa-bookmark input-icon"></i>
                            <input
                                type="text"
                                id="subject"
                                name="subject"
                                placeholder="How can we help you?"
                                required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="message">Message</label>
                        <div class="input-wrapper textarea-wrapper">
                            <i class="fa-regular fa-comment-dots input-icon textarea-icon"></i>
                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                placeholder="Describe your issue or feedback in detail..."
                                required></textarea>
                        </div>
                    </div>

                    <button type="submit" class="support-btn submit-btn">
                        <span>Send Message</span>
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>

                </form>
            </div>

        </div>

    </div>
</div>