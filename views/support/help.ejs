<% layout("layouts/boilerplate") %>

<div class="support-page">
    <div class="support-card">

        <div class="support-header">
            <div class="support-icon">
                <i class="fa-solid fa-circle-question"></i>
            </div>
            <span class="support-badge"><i class="fa-solid fa-compass"></i> Knowledge Base</span>
            <h1>Help Center</h1>
            <p>
                Find answers to common questions about bookings, listings, and managing your Wanderlust account.
            </p>
        </div>

        <div class="support-section">
            <div class="section-title-wrapper">
                <h2>Frequently Asked Questions</h2>
                <p>Quick guides to resolve common queries</p>
            </div>

            <div class="help-grid">
                <div class="help-item">
                    <div class="help-icon-wrapper">
                        <i class="fa-solid fa-house-circle-check"></i>
                    </div>
                    <div class="help-content">
                        <h3>How do I book a property?</h3>
                        <p>
                            Browse available properties, open the listing page, choose your travel dates, and follow the simple booking checkout process.
                        </p>
                    </div>
                </div>

                <div class="help-item">
                    <div class="help-icon-wrapper">
                        <i class="fa-solid fa-user-gear"></i>
                    </div>
                    <div class="help-content">
                        <h3>How can I become a host?</h3>
                        <p>
                            Click on "Become a Host" in the navbar, add details about your property, upload photos, set pricing, and publish your listing.
                        </p>
                    </div>
                </div>

                <div class="help-item">
                    <div class="help-icon-wrapper">
                        <i class="fa-solid fa-calendar-xmark"></i>
                    </div>
                    <div class="help-content">
                        <h3>How can I cancel my booking?</h3>
                        <p>
                            Navigate to your user dashboard under "Bookings", select the active reservation, and request a cancellation based on the policy.
                        </p>
                    </div>
                </div>

                <div class="help-item">
                    <div class="help-icon-wrapper">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <div class="help-content">
                        <h3>Are my payment details secure?</h3>
                        <p>
                            Yes, all transactions are processed through encrypted payment gateways to ensure maximum protection for your funds.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="support-contact-box">
            <div class="contact-box-icon">
                <i class="fa-solid fa-headset"></i>
            </div>
            <div class="contact-box-text">
                <h3>Didn't find your answer?</h3>
                <p>Our customer support team is available 24/7 to assist you directly.</p>
            </div>
            <a href="/contact" class="support-btn">Contact Us</a>
        </div>

    </div>
</div>