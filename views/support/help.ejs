<% layout("layouts/boilerplate") %>

<div class="support-page">

    <div class="support-card">

        <div class="support-header">

            <div class="support-icon">
                <i class="fa-solid fa-circle-question"></i>
            </div>

            <h1>Help Center</h1>

            <p>
                Find answers to common questions about bookings,
                listings, and your Wanderlust account.
            </p>

        </div>


        <div class="support-section">

            <h2>How can we help?</h2>


            <div class="help-item">

                <h3>
                    <i class="fa-solid fa-house"></i>
                    How do I book a property?
                </h3>

                <p>
                    Browse available properties, open the listing you like,
                    and follow the booking process.
                </p>

            </div>


            <div class="help-item">

                <h3>
                    <i class="fa-solid fa-user-tie"></i>
                    How can I become a host?
                </h3>

                <p>
                    Click on "Become a Host" and create your property listing.
                </p>

            </div>


            <div class="help-item">

                <h3>
                    <i class="fa-solid fa-calendar-xmark"></i>
                    How can I cancel my booking?
                </h3>

                <p>
                    Go to your bookings section and select the booking
                    you want to cancel.
                </p>

            </div>

        </div>


        <div class="support-contact-box">

            <h3>Need more help?</h3>

            <p>
                You can contact us through our
                <a href="/contact">Contact Us</a> page.
            </p>

        </div>

    </div>

</div>