<% layout("layouts/boilerplate") %>

<div class="support-page">

    <div class="support-card">

        <div class="support-header">

            <div class="support-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h1>Privacy Policy</h1>

            <p>
                Your privacy matters to us. Learn how Wanderlust
                handles your information.
            </p>

        </div>


        <div class="policy-section">
            <h2>Information We Collect</h2>

            <p>
                We may collect information such as your name,
                email address, phone number, account details,
                booking information, and listing details.
            </p>
        </div>


        <div class="policy-section">
            <h2>How We Use Your Information</h2>

            <p>
                Your information may be used to provide our services,
                process bookings, manage your account, improve our
                platform, and communicate with you.
            </p>
        </div>


        <div class="policy-section">
            <h2>Data Security</h2>

            <p>
                We take reasonable measures to protect your personal
                information from unauthorized access or misuse.
            </p>
        </div>


        <div class="policy-section">
            <h2>Contact</h2>

            <p>
                If you have questions regarding this Privacy Policy,
                please visit our <a href="/contact">Contact Us</a> page.
            </p>
        </div>

    </div>

</div>