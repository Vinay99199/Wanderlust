<% layout("layouts/boilerplate") %>

<div class="support-page">
    <div class="support-card">

        <div class="support-header">
            <div class="support-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <span class="support-badge"><i class="fa-solid fa-user-lock"></i> Trust & Security</span>
            <h1>Privacy Policy</h1>
            <p>
                Your privacy is vital to us. Discover how Wanderlust collects, protects, and handles your personal information.
            </p>
            <div class="support-meta">
                <span><i class="fa-regular fa-clock"></i> Last updated: October 2024</span>
                <span><i class="fa-regular fa-eye"></i> Transparent Data Policy</span>
            </div>
        </div>

        <div class="policy-grid">

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-database"></i>
                </div>
                <div class="policy-content">
                    <h2>1. Information We Collect</h2>
                    <p>
                        We collect essential personal data such as your name, email address, phone number, account credentials, booking histories, and listing preferences.
                    </p>
                </div>
            </div>

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div class="policy-content">
                    <h2>2. How We Use Your Information</h2>
                    <p>
                        Your information is used to facilitate smooth bookings, process host payments, protect against fraud, enhance platform features, and notify you of updates.
                    </p>
                </div>
            </div>

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-vault"></i>
                </div>
                <div class="policy-content">
                    <h2>3. Data Protection & Security</h2>
                    <p>
                        We deploy industry-standard encryption, strict access controls, and firewall defenses to prevent unauthorized access or accidental loss of your data.
                    </p>
                </div>
            </div>

            <div class="policy-card">
                <div class="policy-icon-wrapper">
                    <i class="fa-solid fa-cookie-bite"></i>
                </div>
                <div class="policy-content">
                    <h2>4. Cookies & Analytics</h2>
                    <p>
                        We use minimal functional cookies to maintain active login sessions, remember user choices, and aggregate anonymous performance metrics.
                    </p>
                </div>
            </div>

        </div>

        <div class="support-contact-box">
            <div class="contact-box-icon">
                <i class="fa-solid fa-envelope"></i>
            </div>
            <div class="contact-box-text">
                <h3>Have questions about your data?</h3>
                <p>Reach out to our Data Protection Officer for any privacy concerns.</p>
            </div>
            <a href="/contact" class="support-btn">Contact Us</a>
        </div>

    </div>
</div>